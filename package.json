{
  "name": "software-factory",
  "version": "1.0.0",
  "description": "Software Factory Runner",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "test:external": "npm run build && node --test dist/tests/package-boundary.test.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "check": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/rkendel1/factory"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@appport/appboundry": "^1.0.10",
    "@appport/sdk": "^1.1.18",
    "@appport/services": "^0.4.0",
    "@authboundry/core": "^1.15.1",
    "@feltdb/core": "0.11.4"
  },
  "overrides": {
    "@feltdb/core": "$@feltdb/core"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
