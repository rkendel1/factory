flow_version 1

app software_factory {
  collection Work {
    owner_principal: text
    tenant_id: text
    repository_provider: text
    repository_owner: text
    repository_name: text
    repository_ref: text
    ownerPrincipal: text?
    tenantId: text?
    operation: text
    repositoryProvider: text?
    repositoryOwner: text?
    repositoryName: text?
    repositoryRef: text?
    githubConnectionId: text?
    status: text
    index owner_principal using hash(owner_principal)
    index ownerPrincipal using hash(ownerPrincipal)
  }

  collection ExecutionRequest {
    run_id: text
    work_id: text
    runId: ref Run?
    workId: ref Work?
    operation: text
    principal: text
    tenantId: text?
    request: json?
    created_at: datetime
    createdAt: datetime?
    index run_id using hash(run_id)
    index runId using hash(runId)
  }

  collection ExecutionContract {
    run_id: text
    runId: ref Run?
    principal: text
    tenantId: text?
    operation: text
    command_json: text
    commandJson: text?
    contract: json?
    fingerprint: text?
    created_at: datetime
    createdAt: datetime?
    index run_id using hash(run_id)
    index runId using hash(runId)
  }

  collection Run {
    work_id: text
    operationId: text?
    operationVersion: integer?
    workId: ref Work?
    principal: text
    tenant_id: text
    tenantId: text?
    operation: text
    status: text
    idempotencyKey: text?
    repository: json?
    authorizationDecisionId: ref AuthorizationDecision?
    contractId: ref ExecutionContract?
    evidenceId: ref Evidence?
    actionId: ref Action?
    projectId: ref Project?
    environmentId: ref Environment?
    applicationId: text?
    delegationId: text?
    executionProvider: text?
    result: json?
    error: text?
    startedAt: datetime?
    completed_at: datetime
    completedAt: datetime?
    created_at: datetime
    updated_at: datetime
    createdAt: datetime?
    updatedAt: datetime?
    index work_id using hash(work_id)
    index workId using hash(workId)
    index status using hash(status)
  }

  collection RunEvent {
    run_id: text
    runId: ref Run?
    status: text
    detail: text
    created_at: datetime
    createdAt: datetime?
    index run_id using hash(run_id)
    index runId using hash(runId)
  }

  collection Artifact {
    run_id: text
    runId: ref Run?
    path: text
    kind: text
    created_at: datetime
    createdAt: datetime?
    index run_id using hash(run_id)
    index runId using hash(runId)
  }

  collection Evidence {
    run_id: text
    runId: ref Run?
    requestId: ref ExecutionRequest?
    contractId: ref ExecutionContract?
    contractFingerprint: text?
    applicationContractFingerprint: text?
    principal: text?
    tenantId: text?
    operation: text?
    appport: json?
    ref: text?
    executionMode: text?
    github: json?
    authorizationDecisionId: ref AuthorizationDecision?
    status: text
    exitCode: integer?
    startedAt: datetime?
    completedAt: datetime?
    durationMs: integer?
    repository: json?
    stdout: text?
    stderr: text?
    pax: json?
    artifacts: json?
    deterministicResult: text?
    finalResult: text?
    invariant: json?
    jev: json?
    deterministic_result: text
    final_result: text
    created_at: datetime
    index run_id using hash(run_id)
    index runId using hash(runId)
  }

  collection AuthorizationDecision {
    run_id: text
    runId: ref Run?
    principal: text
    tenant_id: text
    tenantId: text?
    authSession: json?
    delegation: json?
    operation: text
    decision: text
    reason: text
    created_at: datetime
    createdAt: datetime?
    index run_id using hash(run_id)
    index runId using hash(runId)
  }

  collection Project {
    tenant_id: text
    tenantId: text?
    name: text
    description: text?
    status: text
    createdAt: datetime?
    updatedAt: datetime?
    created_at: datetime
    updated_at: datetime
    index tenant_id using hash(tenant_id)
    index tenantId using hash(tenantId)
  }

  collection Repository {
    project_id: text
    projectId: ref Project?
    tenantId: text?
    provider: text
    owner: text
    name: text
    defaultBranch: text?
    repositoryUrl: text?
    createdAt: datetime?
    created_at: datetime
    index project_id using hash(project_id)
    index projectId using hash(projectId)
  }

  collection Environment {
    project_id: text
    projectId: ref Project?
    tenantId: text?
    name: text
    provider: text?
    configuration: json?
    currentState: json?
    desiredState: json?
    createdAt: datetime?
    updatedAt: datetime?
    created_at: datetime
    updated_at: datetime
    index project_id using hash(project_id)
    index projectId using hash(projectId)
  }

  collection DesiredState {
    project_id: text
    projectId: ref Project?
    tenantId: text?
    sourceRepositoryId: text?
    sourceBranch: text?
    deploymentEnabled: boolean?
    targetProvider: text?
    healthRequirement: text?
    updatedBy: text?
    createdAt: datetime?
    updatedAt: datetime?
    created_at: datetime
    updated_at: datetime
    index project_id using hash(project_id)
    index projectId using hash(projectId)
  }

  collection Action {
    project_id: text
    projectId: ref Project?
    environmentId: ref Environment?
    tenantId: text?
    type: text
    intent: text
    plan: json?
    discovery: json?
    operation: text?
    executionProvider: text?
    status: text
    runId: ref Run?
    verification: json?
    authority: json?
    createdBy: text?
    createdAt: datetime?
    updatedAt: datetime?
    created_at: datetime
    updated_at: datetime
    index project_id using hash(project_id)
    index projectId using hash(projectId)
    index status using hash(status)
  }

  capability FactoryApplicationAccess {
    visibility internal
    application factory
    grant factory.ui.read
    grant configuration.read
    grant configuration.write
    grant configuration.delete
    grant secret.rotate
    grant apikeys.read
    grant apikeys.create
    grant apikeys.revoke
  }

  capability ArchitectureConformanceExecution {
    visibility internal
    operation architecture-conformance
    principal factory-service
    execution_mode pax
    pax_operation run
    pax_target conformance
    timeoutMs 300000
    grant repository.read
    grant artifact.write
    grant evidence.write
    appport_operation architecture-conformance
    appport_service execution
    appport_capability repository.read
    jev bounded
  }

  capability RepositoryEchoExecution {
    visibility internal
    operation repo-echo
    principal factory-service
    execution_mode native
    command ["node","-e","console.log('authorized')"]
    timeoutMs 10000
    grant repository.read
    grant evidence.write
    appport_operation repo-echo
    appport_service execution
    appport_capability repository.read
    jev bounded
  }

  capability GitHubRepositoriesListExecution {
    visibility internal
    operation repositories.list
    principal factory-service
    execution_mode integration
    integration github
    github_operation repositories.list
    timeoutMs 60000
    grant github.repository.read
    appport_operation repositories.list
    appport_service github
    appport_capability github.repository.read
    jev bounded
  }

  capability GitHubPullRequestMergeExecution {
    visibility internal
    operation pull_request.merge
    principal factory-service
    execution_mode integration
    integration github
    github_operation pull_request.merge
    timeoutMs 60000
    grant github.pull_request.merge
    appport_operation pull_request.merge
    appport_service github
    appport_capability github.pull_request.merge
    jev bounded
  }

  policy Project {
    read: authenticated
    write: none
  }

  policy Repository {
    read: authenticated
    write: none
  }

  policy Environment {
    read: authenticated
    write: none
  }

  policy DesiredState {
    read: authenticated
    write: none
  }

  policy Action {
    read: authenticated
    write: none
  }

  policy Work {
    read: authenticated
    write: none
  }

  policy ExecutionRequest {
    read: authenticated
    write: none
  }

  policy ExecutionContract {
    read: authenticated
    write: none
  }

  policy Run {
    read: authenticated
    write: none
  }

  policy RunEvent {
    read: authenticated
    write: none
  }

  policy Artifact {
    read: authenticated
    write: none
  }

  policy Evidence {
    read: authenticated
    write: none
  }

  policy AuthorizationDecision {
    read: authenticated
    write: none
  }
}
