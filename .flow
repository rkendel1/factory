flow_version 1

app software_factory {
  collection Work {
    ownerPrincipal: text
    tenantId: text?
    operation: text
    repositoryProvider: text
    repositoryOwner: text
    repositoryName: text
    repositoryRef: text
    status: text
    index ownerPrincipal using hash(ownerPrincipal)
  }

  collection ExecutionRequest {
    runId: ref Run
    workId: ref Work
    operation: text
    principal: text
    tenantId: text?
    request: json
    createdAt: datetime
    index runId using hash(runId)
  }

  collection ExecutionContract {
    runId: ref Run
    principal: text
    tenantId: text?
    operation: text
    commandJson: text
    contract: json
    fingerprint: text
    createdAt: datetime
    index runId using hash(runId)
  }

  collection Run {
    operationId: text
    operationVersion: integer
    workId: ref Work
    principal: text
    tenantId: text?
    operation: text
    status: text
    idempotencyKey: text
    repository: json
    authorizationDecisionId: ref AuthorizationDecision?
    contractId: ref ExecutionContract?
    evidenceId: ref Evidence?
    error: text?
    startedAt: datetime?
    completedAt: datetime?
    createdAt: datetime
    updatedAt: datetime
    index workId using hash(workId)
    index status using hash(status)
  }

  collection RunEvent {
    runId: ref Run
    status: text
    detail: text
    createdAt: datetime
    index runId using hash(runId)
  }

  collection Artifact {
    runId: ref Run
    path: text
    kind: text
    createdAt: datetime
    index runId using hash(runId)
  }

  collection Evidence {
    runId: ref Run
    requestId: ref ExecutionRequest?
    contractId: ref ExecutionContract?
    contractFingerprint: text
    applicationContractFingerprint: text?
    principal: text?
    tenantId: text?
    operation: text?
    appport: json?
    ref: text?
    executionMode: text?
    authorizationDecisionId: ref AuthorizationDecision
    status: text
    exitCode: integer?
    startedAt: datetime
    completedAt: datetime
    durationMs: integer
    repository: json
    stdout: text
    stderr: text
    pax: json?
    artifacts: json
    deterministicResult: text
    finalResult: text
    invariant: json?
    jev: json?
    index runId using hash(runId)
  }

  collection AuthorizationDecision {
    runId: ref Run
    principal: text
    tenantId: text
    authSession: json?
    delegation: json?
    operation: text
    decision: text
    reason: text
    createdAt: datetime
    index runId using hash(runId)
  }

  capability ArchitectureConformanceExecution {
    visibility internal
    operation architecture-conformance
    principal factory-service
    execution_mode pax
    pax_operation run
    pax_target conformance
    timeoutMs 300000
    grant repository.read
    grant artifact.write
    grant evidence.write
    appport_operation architecture-conformance
    appport_service execution
    appport_capability repository.read
    jev bounded
  }

  capability RepositoryEchoExecution {
    visibility internal
    operation repo-echo
    principal factory-service
    execution_mode native
    command ["node","-e","console.log('authorized')"]
    timeoutMs 10000
    grant repository.read
    grant evidence.write
    appport_operation repo-echo
    appport_service execution
    appport_capability repository.read
    jev bounded
  }

  policy Work {
    read: authenticated
    write: authenticated
  }

  policy ExecutionRequest {
    read: authenticated
    write: authenticated
  }

  policy ExecutionContract {
    read: authenticated
    write: none
  }

  policy Run {
    read: authenticated
    write: authenticated
  }

  policy RunEvent {
    read: authenticated
    write: authenticated
  }

  policy Artifact {
    read: authenticated
    write: authenticated
  }

  policy Evidence {
    read: authenticated
    write: authenticated
  }

  policy AuthorizationDecision {
    read: authenticated
    write: none
  }
}
